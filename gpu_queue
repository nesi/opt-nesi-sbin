# Column widths for the per-bucket job tables.
_W_JOB    = 12
_W_USER   = 10
_W_STATE  = 14
_W_PART   = 12
_W_NODE   = 16
_W_CPU    = 6
_W_MEM    = 10
_W_START  = 19
_W_X      = 12
_W_TRES   = 56
_W_REASON = 22

def _running_columns(bucket_key: str, types: Optional[List[str]]):
    return [
        ("JOBID",  _W_JOB,   lambda r: r.jobid),
        ("USER",   _W_USER,  lambda r: r.user),
        ("PART",   _W_PART,  lambda r: r.partition),
        ("NODE",   _W_NODE,  lambda r: r.nodelist),
        ("CPU",    _W_CPU,   lambda r: halve_cpu_count_str(r.cpus)),
        ("Memory", _W_MEM,   lambda r: format_slurm_mem_as_gb(r.mem)),
        ("START",  _W_START, lambda r: r.start),
        ("LEFT",   _W_X,     lambda r: r.timeleft),
        ("TRES",   _W_TRES,  lambda r: tres_with_alloc_annotation(r, bucket_key, types)),
    ]

def _pending_columns(bucket_key: str, types: Optional[List[str]]):
    return [
        ("JOBID",  _W_JOB,    lambda r: r.jobid),
        ("USER",   _W_USER,   lambda r: r.user),
        ("PART",   _W_PART,   lambda r: r.partition),
        ("CPU",    _W_CPU,    lambda r: halve_cpu_count_str(r.cpus)),
        ("Memory", _W_MEM,    lambda r: format_slurm_mem_as_gb(r.mem)),
        ("START",  _W_START,  lambda r: r.start),
        ("LIMIT",  _W_X,      lambda r: r.timelimit),
        ("TRES",   _W_TRES,   lambda r: tres_with_alloc_annotation(r, bucket_key, types)),
        ("REASON", _W_REASON, lambda r: r.reason),
    ]

def _other_columns(bucket_key: str, types: Optional[List[str]]):
    return [
        ("JOBID",  _W_JOB,   lambda r: r.jobid),
        ("USER",   _W_USER,  lambda r: r.user),
        ("STATE",  _W_STATE, lambda r: r.state),
        ("PART",   _W_PART,  lambda r: r.partition),
        ("NODE",   _W_NODE,  lambda r: r.nodelist),
        ("CPU",    _W_CPU,   lambda r: halve_cpu_count_str(r.cpus)),
        ("Memory", _W_MEM,   lambda r: format_slurm_mem_as_gb(r.mem)),
        ("TRES",   _W_TRES,  lambda r: tres_with_alloc_annotation(r, bucket_key, types)),
    ]

def print_jobs_table(
    rows: List[QueueRow],
    columns: List[Tuple[str, int, Callable[[QueueRow], str]]],
) -> None:
    """Print a fixed-width job table. Each column is a (label, width, getter)
    triple where getter(row) returns the cell's string value."""
    if not rows:
        return
    header = "    " + " ".join(f"{label:<{w}}" for label, w, _ in columns)
    print(header)
    print("    " + "-" * (len(header) - 4))
    for row in rows:
        cells = " ".join(f"{_truncate(get(row), w):<{w}}" for _, w, get in columns)
        print("    " + cells)

# =============================================================================
# Node availability via sinfo
# =============================================================================

_MAINT_PART_RE = re.compile(r"maint", re.IGNORECASE)

_GPU_GRES_NODE_RE = re.compile(
    r"""
    ^\s*gpu
    (?::(?P<model>[^:(),\s]+))?
    (?::(?P<count>\d+))?
    (?:\([^)]*\))?
    \s*$
    """,
    re.VERBOSE,
)

def _split_gres_entries(gres_field: str) -> List[str]:
    """Split a Slurm Gres field on top-level commas, ignoring commas inside parentheses."""
    s = (gres_field or "").strip()
    if not s:
        return []
    out: List[str] = []
    buf: List[str] = []
    depth = 0
    for ch in s:
        if ch == "(":
            depth += 1
            buf.append(ch)
        elif ch == ")":
            if depth > 0:
                depth -= 1
            buf.append(ch)
        elif ch == "," and depth == 0:
            token = "".join(buf).strip()
            if token:
                out.append(token)
            buf = []
        else:
            buf.append(ch)
    token = "".join(buf).strip()
    if token:
        out.append(token)
    return out

def _parse_gpu_gres(gres_field: str) -> Dict[str, int]:
    """Return {model: count} for GPU entries in a Slurm Gres field; {} if none."""
    s = (gres_field or "").strip()
    if not s or s == "(null)":
        return {}
    out: Dict[str, int] = {}
    for entry in _split_gres_entries(s):
        m = _GPU_GRES_NODE_RE.match(entry.strip())
        if not m:
            continue
        model = m.group("model") or "(generic)"
        count_str = m.group("count")
        try:
            count = 1 if count_str is None else int(count_str)
        except ValueError:
            count = 0
        if count <= 0:
            continue
        out[model] = out.get(model, 0) + count
    return out

def _is_node_unavailable(state: str) -> bool:
    """True if the node state means GPUs cannot be scheduled (down/drained/draining/fail/planned/maint/resv)."""
    s = re.sub(r"[^a-z]", "", (state or "").strip().lower())
    return s in {"down", "drained", "draining", "fail", "failing", "planned", "maint", "resv"}

@dataclass
class _NodeAvail:
    node: str
    partition: str
    state: str
    gpu_total: Dict[str, int]

@dataclass
class BucketNodeStats:
    total_gpus: int = 0
    unavailable_gpus: int = 0
    unavailable_nodes: List[str] = field(default_factory=list)

def _get_node_avail() -> List[_NodeAvail]:
    """Query sinfo -N and return one record per GPU node (maint partition excluded, deduplicated by node name)."""
    cmd = ["sinfo", "-N", "--noheader",
           "--Format=nodelist:32,Partition:24,StateLong:20,Gres:90"]
    widths = [32, 24, 20, 90]
    try:
        txt = run_text_cmd(cmd)
    except RuntimeError:
        return []
    seen: set = set()
    out: List[_NodeAvail] = []
    for ln in txt.splitlines():
        if not ln.strip():
            continue
        fields: List[str] = []
        pos = 0
        for w in widths:
            fields.append(ln[pos:pos + w].strip())
            pos += w
        if len(fields) < 4:
            continue
        node, partition, state, gres = fields
        if _MAINT_PART_RE.search(partition or ""):
            continue
        if node in seen:
            continue
        seen.add(node)
        gpu_total = _parse_gpu_gres(gres)
        if not gpu_total:
            continue
        out.append(_NodeAvail(node=node, partition=partition, state=state, gpu_total=gpu_total))
    return out

def _compute_bucket_avail(nodes: List[_NodeAvail], types: Optional[List[str]]) -> Dict[str, BucketNodeStats]:
    """Aggregate per-node GPU data into per-bucket availability stats."""
    out: Dict[str, BucketNodeStats] = {}
    for node in nodes:
        for model, count in node.gpu_total.items():
            base_key = canonical_gpu_key(model)
            bucket = queue_bucket_key_for_job(base_key, node.partition, node.node)
            filtered = filter_queue_keys_by_type({bucket: count}, types)
            for bk, cnt in filtered.items():
                stats = out.setdefault(bk, BucketNodeStats())
                stats.total_gpus += cnt
                if _is_node_unavailable(node.state):
                    stats.unavailable_gpus += cnt
                    stats.unavailable_nodes.append(f"{node.node} [{node.state}]")
    return out

