def parse_type_arg(s: Optional[str]) -> Optional[List[str]]:
    """Parse -t/--type as comma-separated list, e.g. a100,l4,h100,generic"""
    if not s:
        return None
    items: List[str] = []
    for tok in s.split(","):
        t = tok.strip().lower()
        if t:
            items.append(t)
    return items or None

def build_arg_parser() -> argparse.ArgumentParser:
    """Build the argparse parser. Flag: -t GPU type filter."""
    p = argparse.ArgumentParser(description="Show a detailed Slurm queue report broken down by GPU type.")
    p.add_argument(
        "-t",
        "--type",
        type=str,
        default=None,
        help="Comma-separated GPU types to include (e.g., a100,l4,h100,generic).",
    )
    return p

def main(argv: Optional[List[str]] = None) -> int:
    """Entry point: parse CLI args and print the detailed queue report."""
    args = build_arg_parser().parse_args(argv)
    types = parse_type_arg(args.type)
    queue_report(types=types)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())