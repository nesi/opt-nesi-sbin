#!/usr/bin/env python3
"""
gpu_queue — print a detailed Slurm queue report broken down by GPU type.

Per GPU bucket, shows running, pending, and (when present) other-state jobs
with CPU/Memory/time/TRES details. A100 jobs are split into 80GB / 40GB /
unknown buckets based on partition (milan/genoa) and nodelist.
Self-contained: no external project modules.
"""

from __future__ import annotations

import argparse
import math
import re
import subprocess
from dataclasses import dataclass, field
from datetime import datetime, timezone, timedelta
from typing import Any, Callable, Dict, List, Optional, Tuple

from tqdm import tqdm

# =============================================================================
# Subprocess helpers
# =============================================================================

def run_text_cmd(cmd: List[str]) -> str:
    """Run an external command and return its stdout as text. Raise RuntimeError on non-zero exit."""
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if p.returncode != 0:
        raise RuntimeError(
            f"Command failed: {' '.join(cmd)}\n"
            f"Exit code: {p.returncode}\n"
            f"STDERR:\n{p.stderr.strip()}"
        )
    return p.stdout

# =============================================================================
# Slurm value parsing (time, duration, memory)
# =============================================================================

def parse_slurm_duration(s: str) -> Optional[timedelta]:
    """Parse Slurm duration formats ('D-HH:MM:SS', 'HH:MM:SS', 'MM:SS', 'M') into a timedelta, or None if not parseable."""
    if not s:
        return None
    ss = s.strip()
    if ss.lower() in {"unlimited", "infinite", "n/a", "unknown", "(null)", "not_set", "not set"}:
        return None

    days = 0
    if "-" in ss:
        d, rest = ss.split("-", 1)
        if d.isdigit():
            days = int(d)
        ss = rest

    parts = ss.split(":")
    try:
        if len(parts) == 3:
            h, m, sec = (int(x) for x in parts)
        elif len(parts) == 2:
            h = 0
            m, sec = (int(x) for x in parts)
        elif len(parts) == 1:
            h = 0
            m = int(parts[0])
            sec = 0
        else:
            return None
        return timedelta(days=days, hours=h, minutes=m, seconds=sec)
    except Exception:
        return None

def parse_slurm_time(s: str) -> Optional[datetime]:
    """Parse Slurm timestamp strings (ISO-ish or 'Mon DD HH:MM[:SS]') as a UTC datetime; None if unknown/unparseable."""
    if not s:
        return None
    ss = s.strip()
    if ss.lower() in {"n/a", "unknown", "(null)"}:
        return None

    local_tz = datetime.now().astimezone().tzinfo

    ss_norm = ss.replace(" ", "T")
    try:
        if re.search(r"\d{4}-\d{2}-\d{2}", ss_norm):
            dt = datetime.fromisoformat(ss_norm.replace("Z", ""))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=local_tz)
            return dt.astimezone(timezone.utc)
    except Exception:
        pass

    for fmt in ("%b %d %H:%M", "%b %d %H:%M:%S"):
        try:
            dt_naive = datetime.strptime(ss, fmt)
            dt = dt_naive.replace(year=datetime.now().year, tzinfo=local_tz)
            return dt.astimezone(timezone.utc)
        except Exception:
            continue

    return None

_MEM_RE = re.compile(r"^\s*(?P<num>\d+(?:\.\d+)?)\s*(?P<unit>[KMGTP]?)\s*$", re.IGNORECASE)
def slurm_mem_to_mb(mem_str: str) -> Optional[int]:
    """
    Convert Slurm-like memory strings to MB.
    Accepts: '13500M', '4G', '1024K', '1T', '500' (assumed MB), '1.5G'
    Returns integer MB, or None if not parseable.
    """
    if not mem_str:
        return None
    s = mem_str.strip()
    if not s or s.lower() in {"n/a", "unknown", "(null)", "not_set", "not set"}:
        return None

    m = _MEM_RE.match(s)
    if not m:
        return None

    num = float(m.group("num"))
    unit = (m.group("unit") or "").upper()

    if unit == "" or unit == "M":
        mb = num
    elif unit == "K":
        mb = num / 1024.0
    elif unit == "G":
        mb = num * 1024.0
    elif unit == "T":
        mb = num * 1024.0 * 1024.0
    elif unit == "P":
        mb = num * 1024.0 * 1024.0 * 1024.0
    else:
        return None

    return int(round(mb))

# =============================================================================
# Display formatting (strings, CPU, memory)
# =============================================================================

def _truncate(s: str, width: int) -> str:
    """Truncate `s` to fit in `width` characters, replacing the cut tail with '…' when shortened."""
    s = (s or "")
    if len(s) <= width:
        return s
    if width <= 1:
        return s[:width]
    return s[: max(0, width - 1)] + "…"

def format_mb_as_gb(mb: int) -> str:
    """Format an integer MB value as an 'X GB' string. Uses a whole number when
    the value is effectively an integer count of GB, otherwise one decimal
    place. Returns '0 GB' for zero or negative input."""
    if mb <= 0:
        return "0 GB"
    gb = mb / 1024.0
    if abs(gb - round(gb)) < 1e-9:
        return f"{int(round(gb))} GB"
    return f"{gb:.1f} GB"

def format_slurm_mem_as_gb(mem_str: str) -> str:
    """Format a Slurm-style memory string (e.g. '13500M', '4G') for display in GB; 'N/A' if unparseable."""
    mb = slurm_mem_to_mb(mem_str)
    if mb is None:
        return "N/A"
    return format_mb_as_gb(mb)

def halve_cpu_count_str(cpus_str: str) -> str:
    """Halve a CPU-count string, rounding up (e.g. '8' -> '4', '3' -> '2',
    '1' -> '1'); returns 'N/A' if not an integer. Used to display physical
    CPU counts when squeue's %C reports the hyperthread-doubled logical
    count. Round-up matches "physical cores reserved" semantics: an odd
    logical count still consumes a whole physical core."""
    try:
        return str(math.ceil(int(cpus_str.strip()) / 2))
    except Exception:
        return "N/A"

# =============================================================================
# GPU type canonicalization and bucketing
# =============================================================================

def canonical_gpu_key(model: str) -> str:
    """Map a raw GPU model string (e.g. 'a100', 'h100', 'gpu')
    to a canonical key: 'a100', 'h100', 'l4', 'generic', or the 
    lowercased input as a fallback when no rule matches."""
    ml = (model or "").strip().lower()
    if "h100" in ml:
        return "h100"
    if "a100" in ml:
        return "a100"
    if re.search(r"\bl4\b", ml):
        return "l4"
    if ml in {"gpu", "(generic)", "generic"}:
        return "generic"
    return ml

_A100_80GB_MG_RE = re.compile(r"\bmg(13|14|15|16)\b", re.IGNORECASE)
_G_NODE_RE = re.compile(r"\bg\d+\b", re.IGNORECASE)
def a100_variant_for_queue(partition: str, nodelist: str) -> str:
    """
    Determine A100 VRAM variant for queue bucketing.

    Priority:
      1) partition has BOTH milan and genoa -> unknown
      2) partition has milan -> 80GB
      3) partition has genoa -> 40GB
      4) nodelist has mg13-16 -> 80GB
      5) nodelist has g* -> 40GB
      else -> unknown
    """
    p = (partition or "").lower()
    has_milan = "milan" in p
    has_genoa = "genoa" in p
    if has_milan and has_genoa:
        return "a100_unknown"
    if has_milan:
        return "a100_80"
    if has_genoa:
        return "a100_40"

    s = (nodelist or "").lower()
    if _A100_80GB_MG_RE.search(s):
        return "a100_80"
    if _G_NODE_RE.search(s) or re.search(r"\bg\[[0-9,\-]+\]", s):
        return "a100_40"
    return "a100_unknown"

def queue_bucket_key_for_job(base_key: str, partition: str, nodelist: str) -> str:
    """Return the queue bucket key for a job: split A100 by VRAM (80/40/unknown); pass other GPU types through unchanged."""
    if base_key == "a100":
        return a100_variant_for_queue(partition, nodelist)
    return base_key

def pretty_queue_key(key: str) -> str:
    """Map an internal bucket key (a100_80, h100, generic, ...) to a human-readable label for output."""
    k = (key or "").lower()
    if k == "h100":
        return "H100"
    if k == "a100_80":
        return "A100 (80GB)"
    if k == "a100_40":
        return "A100 (40GB)"
    if k == "a100_unknown":
        return "A100 (VRAM has not been specified)"
    if k == "l4":
        return "L4"
    if k == "generic":
        return "GPU (GPU has not been specified)"
    return key

def filter_queue_keys_by_type(keys: Dict[str, int], types: Optional[List[str]]) -> Dict[str, int]:
    """Filter a {queue_bucket_key: count} dict by `types`. The pseudo-type 'a100'
    matches all A100 buckets (a100_80, a100_40, a100_unknown); other types must
    match exactly. Returns the input unchanged when `types` is None/empty."""
    if not types:
        return keys
    keep = set(x.lower() for x in types)
    out: Dict[str, int] = {}
    for k, v in (keys or {}).items():
        kl = (k or "").lower()
        if kl.startswith("a100_"):
            if "a100" in keep:
                out[k] = out.get(k, 0) + int(v)
        else:
            if kl in keep:
                out[k] = out.get(k, 0) + int(v)
    return out

# =============================================================================
# TRES parsing (requests and allocations)
# =============================================================================

# Patterns for squeue's %b / tres-per-node field (job request).
_GPU_PATTERNS_TRES = [
    re.compile(r"gpu:(?P<type>[A-Za-z0-9_.-]+):(?P<count>\d+)", re.IGNORECASE),
    re.compile(r"gres/gpu:(?P<type>[A-Za-z0-9_.-]+)=(?P<count>\d+)", re.IGNORECASE),
    re.compile(r"gres:gpu:(?P<type>[A-Za-z0-9_.-]+)=(?P<count>\d+)", re.IGNORECASE),
    re.compile(r"(?:gres[:/])?gpu=(?P<count>\d+)", re.IGNORECASE),
    re.compile(r"(?:gres[:/])?gpu:(?P<count>\d+)", re.IGNORECASE),
]

def parse_gpu_types_from_tres(tres_field: str) -> Dict[str, int]:
    """Parse a Slurm TRES string (e.g. squeue's %b field) into
    {canonical_gpu_key: count}. Returns {} when no GPUs are requested or when
    'gpu=0' is the only GPU spec."""
    out: Dict[str, int] = {}
    if not tres_field:
        return out

    s = tres_field.strip()
    for pat in _GPU_PATTERNS_TRES:
        for m in pat.finditer(s):
            gd = m.groupdict()
            cnt = int(gd.get("count") or 0)
            if cnt <= 0:
                continue
            typ = gd.get("type")
            key = canonical_gpu_key(typ) if typ else "generic"
            out[key] = out.get(key, 0) + cnt

    return out

# AllocTRES typed allocations: gres/gpu:TYPE=COUNT
_RE_ALLOCTRES_GPU_TYPED = re.compile(r"gres/gpu:(?P<type>[A-Za-z0-9_.-]+)=(?P<count>\d+)", re.IGNORECASE)
def parse_alloc_tres_typed_gpus(alloc_tres: str) -> Dict[str, int]:
    """Parse typed GPU allocations ('gres/gpu:TYPE=COUNT') from a sacct AllocTRES string into {canonical_key: count}."""
    out: Dict[str, int] = {}
    s = (alloc_tres or "").strip()
    if not s:
        return out
    for m in _RE_ALLOCTRES_GPU_TYPED.finditer(s):
        gtype = canonical_gpu_key(m.group("type"))
        cnt = int(m.group("count"))
        if cnt > 0:
            out[gtype] = out.get(gtype, 0) + cnt
    return out

_GRES_GPU_PREFIX_RE = re.compile(r"^\s*gres[/:]gpu([:=])", re.IGNORECASE)
def extract_gpu_only_tres(alloc_tres_raw: str) -> str:
    """Extract just the GPU tokens from a Slurm AllocTRES string and normalize
    their prefix from 'gres/gpu'/'gres:gpu' to 'gpu'. Returns the surviving
    tokens joined by commas (e.g. 'gpu:a100=2'); '' if none are present."""
    s = (alloc_tres_raw or "").strip()
    if not s:
        return ""

    gpu_tokens: List[str] = []
    for tok in (t.strip() for t in s.split(",") if t.strip()):
        if "gpu" not in tok.lower():
            continue
        tok = _GRES_GPU_PREFIX_RE.sub(r"gpu\1", tok).strip()
        if tok:
            gpu_tokens.append(tok)

    return ",".join(gpu_tokens)

# =============================================================================
# squeue data acquisition
# =============================================================================

@dataclass
class QueueRow:
    jobid: str
    state: str
    user: str
    submit: str
    start: str
    timelimit: str
    timeleft: str
    tres: str        # squeue tres-per-node (request)
    partition: str   # squeue %P
    nodelist: str    # squeue %N
    cpus: str        # squeue %C
    mem: str         # squeue %m (may be 4G / 13500M / etc)
    reason: str
    alloc_tres: str = ""   # squeue tres-alloc (running jobs only; empty for pending)

def get_squeue_rows() -> List[QueueRow]:
    """Run squeue once for all RUNNING and PENDING jobs and parse each line
    into a QueueRow.

    Uses the long-form `-O` field list (rather than `-o` short codes) so we
    can include `tres-alloc` -- AllocTRES isn't exposed via short codes.
    Each field is given a `|` suffix to keep pipe-delimited parsing; widths
    are generous to avoid truncation on long values (array job IDs, big
    nodelists, verbose AllocTRES strings).
    """
    fields = [
        ("JobID", 32),
        ("State", 16),
        ("UserName", 32),
        ("SubmitTime", 24),
        ("StartTime", 24),
        ("TimeLimit", 16),
        ("TimeLeft", 16),
        ("tres-per-node", 256),
        ("Partition", 32),
        ("NodeList", 128),
        ("NumCPUs", 8),
        ("MinMemory", 16),
        ("Reason", 64),
        ("tres-alloc", 512),
    ]
    fmt = ",".join(f"{name}:{width}|" for name, width in fields)
    cmd = ["squeue", "-h", "-t", "all", "-O", fmt]
    txt = run_text_cmd(cmd)

    rows: List[QueueRow] = []
    for ln in txt.splitlines():
        if not ln.strip():
            continue
        # Each field has a trailing `|`, so splitting yields N+1 parts with
        # an empty tail; we just need the first 14.
        parts = ln.rstrip("\n").split("|")
        if len(parts) < 14:
            continue
        rows.append(
            QueueRow(
                jobid=parts[0].strip(),
                state=parts[1].strip(),
                user=parts[2].strip(),
                submit=parts[3].strip(),
                start=parts[4].strip(),
                timelimit=parts[5].strip(),
                timeleft=parts[6].strip(),
                tres=parts[7].strip(),
                partition=parts[8].strip(),
                nodelist=parts[9].strip(),
                cpus=parts[10].strip(),
                mem=parts[11].strip(),
                reason=parts[12].strip(),
                alloc_tres=parts[13].strip(),
            )
        )
    return rows

# =============================================================================
# Per-row helpers used by the report
# =============================================================================

def rebucket_counts_for_row(row: QueueRow, base_counts: Dict[str, int]) -> Dict[str, int]:
    """Re-bucket a {canonical_gpu_key: count} dict for one job, applying the A100 80/40 split using its partition/nodelist."""
    out: Dict[str, int] = {}
    for base_k, cnt in base_counts.items():
        bk = queue_bucket_key_for_job(base_k, row.partition, row.nodelist)
        out[bk] = out.get(bk, 0) + int(cnt)
    return out

def tres_with_alloc_annotation(row: QueueRow, bucket_key: str, types: Optional[List[str]]) -> str:
    """Return row.tres, suffixed with the GPU portion of AllocTRES when the
    request count and allocation count for `bucket_key` disagree."""
    if not row.alloc_tres:
        return row.tres

    req_base     = parse_gpu_types_from_tres(row.tres)
    req_bucket   = filter_queue_keys_by_type(rebucket_counts_for_row(row, req_base), types)
    alloc_typed  = parse_alloc_tres_typed_gpus(row.alloc_tres) or {}
    alloc_bucket = filter_queue_keys_by_type(rebucket_counts_for_row(row, alloc_typed), types)

    req_cnt   = int(req_bucket.get(bucket_key, 0))
    alloc_cnt = int(alloc_bucket.get(bucket_key, 0))
    if req_cnt == alloc_cnt:
        return row.tres

    alloc_gpu_only = extract_gpu_only_tres(row.alloc_tres)
    return f"{row.tres} (AllocTRES: {alloc_gpu_only})" if alloc_gpu_only else row.tres

