# Display order for bucket sections.
_BUCKET_ORDER = {"h100": 0, "a100_40": 1, "a100_80": 2, "a100_unknown": 3, "l4": 4, "generic": 5}
# Fallback "/N" suffixes used only when sinfo is unavailable.
_BUCKET_TOTAL = {"h100": "/8", "a100_80": "/16", "a100_40": "/8", "l4": "/16"}

def _bucket_sort_key(k: str):
    """Sort key for GPU bucket display order: a100_40, a100_80, a100_unknown, h100, l4, generic, then everything else."""
    return (_BUCKET_ORDER.get(k, 99), k)

@dataclass
class QAgg:
    running_jobs: int = 0
    pending_jobs: int = 0
    other_jobs: int = 0
    running_gpus: int = 0
    pending_gpus: int = 0
    other_gpus: int = 0
    running_end_times: List[datetime] = field(default_factory=list)
    pending_start_times: List[datetime] = field(default_factory=list)
    run_rows: List[Tuple[Tuple[Any, ...], QueueRow]] = field(default_factory=list)
    pend_rows: List[Tuple[Tuple[Any, ...], QueueRow]] = field(default_factory=list)
    other_rows: List[Tuple[Tuple[Any, ...], QueueRow]] = field(default_factory=list)

def queue_report(types: Optional[List[str]]) -> None:
    """Build and print the detailed GPU queue report: per-bucket running/pending
    counts and per-job tables for both running and pending jobs. `types`
    filters which GPU types are included."""
    now = datetime.now(timezone.utc)
    rows = get_squeue_rows()
    bucket_avail = _compute_bucket_avail(_get_node_avail(), types)

    # Sentinels so jobs with missing times sort to the end.
    BIG_DT = datetime.max.replace(tzinfo=timezone.utc)
    BIG_TD = timedelta(days=10_000)

    agg: Dict[str, QAgg] = {}

    # ------------------------------------------------------------------------
    # Phase 1: bucket every squeue row into per-GPU-type accumulators.
    # ------------------------------------------------------------------------
    for row in tqdm(rows, desc="Processing jobs", unit="job", leave=False):

        st = (row.state or "").upper()
        is_running = st.startswith("RUN")
        is_pending = st.startswith("PEND")

        # Requested GPUs (always available, including for pending jobs).
        gpu_req_raw = parse_gpu_types_from_tres(row.tres)

        # Allocated GPUs (running jobs only). Gives us the canonical type when
        # the request was just "gpu" without a type.
        gpu_alloc_raw = parse_alloc_tres_typed_gpus(row.alloc_tres) if row.alloc_tres else {}

        # Skip rows with no GPU involvement at all.
        if not gpu_req_raw and not gpu_alloc_raw:
            continue

        # When tres-per-node is absent (some jobs omit it), fall back to
        # alloc_tres so the job still appears in the report.
        effective_req_raw = gpu_req_raw or gpu_alloc_raw

        gpu_req = rebucket_counts_for_row(row, effective_req_raw)
        gpu_req = filter_queue_keys_by_type(gpu_req, types)
        if not gpu_req:
            continue

        gpu_alloc = rebucket_counts_for_row(row, gpu_alloc_raw)
        gpu_alloc = filter_queue_keys_by_type(gpu_alloc, types)

        # Prefer allocation info; fall back to the request when not yet
        # allocated (e.g. pending jobs).
        gpu_information = gpu_alloc if gpu_alloc else gpu_req

        start_dt = parse_slurm_time(row.start)
        left_td  = parse_slurm_duration(row.timeleft)
        limit_td = parse_slurm_duration(row.timelimit)

        for gtype, gcount in gpu_information.items():
            an_agg = agg.setdefault(gtype, QAgg())

            if is_running:
                an_agg.running_jobs += 1
                an_agg.running_gpus += int(gcount)
                if left_td is not None:
                    an_agg.running_end_times.append(now + left_td)
                sort_key = (
                    start_dt if start_dt is not None else BIG_DT,
                    left_td  if left_td  is not None else BIG_TD,
                    row.jobid,
                )
                an_agg.run_rows.append((sort_key, row))

            elif is_pending:
                an_agg.pending_jobs += 1
                an_agg.pending_gpus += int(gcount)
                if start_dt is not None:
                    an_agg.pending_start_times.append(start_dt)
                sort_key = (
                    start_dt if start_dt is not None else BIG_DT,
                    limit_td if limit_td is not None else BIG_TD,
                    row.jobid,
                )
                an_agg.pend_rows.append((sort_key, row))

            else:
                # Anything that is neither RUNNING nor PENDING (COMPLETING,
                # SUSPENDED, CONFIGURING, REQUEUED, ...).
                an_agg.other_jobs += 1
                an_agg.other_gpus += int(gcount)
                sort_key = (
                    start_dt if start_dt is not None else BIG_DT,
                    left_td  if left_td  is not None else BIG_TD,
                    row.jobid,
                )
                an_agg.other_rows.append((sort_key, row))

    # ------------------------------------------------------------------------
    # Phase 2: render the report.
    # ------------------------------------------------------------------------
    if not agg:
        print("No GPU jobs found in squeue (matching filters).")
        return

    print("GPU queue detailed report (per GPU type)")
    if types:
        print(f"  Filter: {', '.join(types)}")

    for gtype in sorted(agg.keys(), key=_bucket_sort_key):
        an_agg = agg[gtype]
        print("")
        print(f"{pretty_queue_key(gtype)}")

        avail = bucket_avail.get(gtype)
        if avail and avail.unavailable_gpus > 0:
            nodes_str = ", ".join(avail.unavailable_nodes)
            print(f"  Unavailable GPUs: {avail.unavailable_gpus}  (nodes: {nodes_str})")
        total_suffix = f"/{avail.total_gpus}" if avail else _BUCKET_TOTAL.get(gtype, "")
        print(f"  Running jobs: {an_agg.running_jobs} (GPUs: {an_agg.running_gpus}{total_suffix})")
        if an_agg.run_rows:
            an_agg.run_rows.sort(key=lambda x: x[0])
            run_rows = [r for _, r in an_agg.run_rows]
            print_jobs_table(run_rows, _running_columns(gtype, types))

        print(f"  Pending jobs: {an_agg.pending_jobs} (GPUs: {an_agg.pending_gpus})")
        if an_agg.pend_rows:
            an_agg.pend_rows.sort(key=lambda x: x[0])
            pend_rows = [r for _, r in an_agg.pend_rows]
            print_jobs_table(pend_rows, _pending_columns(gtype, types))

        # Other-state jobs (suspended, completing, configuring, requeued, ...)
        # are only shown when present so the common case stays uncluttered.
        if an_agg.other_jobs > 0:
            print(f"  Other-state jobs: {an_agg.other_jobs} (GPUs: {an_agg.other_gpus})")
            an_agg.other_rows.sort(key=lambda x: x[0])
            other_rows = [r for _, r in an_agg.other_rows]
            print_jobs_table(other_rows, _other_columns(gtype, types))

        print("")

